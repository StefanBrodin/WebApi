{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                // Works with the solution file, but also possible to point to the specific project 
                "${workspaceFolder}/WebApi.slnx",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                // Point to the specific project to publish, not the solution file
                "${workspaceFolder}/0_AppWebApi/0_AppWebApi.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                // FIX: Point to the actual project to run/watch, not the solution file
                "--project",
                "${workspaceFolder}/0_AppWebApi/0_AppWebApi.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
